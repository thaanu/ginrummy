# systemd alternative to the Supervisor program of the same name.
# Install to /etc/systemd/system/ginrummy-reverb.service, then:
#   systemctl daemon-reload && systemctl enable --now ginrummy-reverb

[Unit]
Description=Gin Rummy Reverb WebSocket server
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ginrummy/current
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
